@model ErrorViewModel
@{
    ViewData["Title"] = "เกิดข้อผิดพลาด";
}

<section class="sw-error">
    <h1>เกิดข้อผิดพลาด</h1>
    <p>ระบบทำรายการไม่สำเร็จ ลองใหม่อีกครั้งในอีกสักครู่</p>

    @if (Model.ShowRequestId)
    {
        <p><small>Request ID: <code>@Model.RequestId</code></small></p>
    }

    <a class="sw-btn sw-btn-primary" asp-controller="Stock" asp-action="Index">กลับไปหน้ารายการ</a>
</section>
