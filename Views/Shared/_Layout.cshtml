<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shopee Stock Watch</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="sw-header">
        <div class="sw-container sw-header-inner">
            <a class="sw-brand" asp-controller="Stock" asp-action="Index">
                <span class="sw-brand-icon">S</span>
                <span>Shopee Stock Watch</span>
            </a>
            <span class="sw-badge">MongoDB</span>
        </div>
    </header>

    <main class="sw-main">
        <div class="sw-container">
            @RenderBody()
        </div>
    </main>

    <footer class="sw-footer">
        <div class="sw-container">
            <p>&copy; @DateTime.Now.Year Shopee Stock Watch · บันทึกสถานะด้วยตนเอง</p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
