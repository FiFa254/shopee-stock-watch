@{
    ViewData["Title"] = "Shopee Stock Watch";
}

<section class="stock-hero">
    <div>
        <p class="stock-eyebrow">Web Application</p>
        <h1>Shopee Stock Watch</h1>
        <p>Add Shopee products, check availability on demand, and let this app check once per day.</p>
    </div>
    <button id="stockNotifyButton" class="btn btn-outline-secondary" type="button">Notify</button>
</section>

<section class="stock-panel">
    <form id="stockAddForm" class="stock-form">
        <label>
            Product name
            <input class="form-control" name="name" placeholder="Headphones, keyboard, limited item" required />
        </label>
        <label class="stock-url-field">
            Shopee URL
            <input class="form-control" name="url" placeholder="https://shopee.co.th/..." required />
        </label>
        <button class="btn btn-primary" type="submit">Add</button>
    </form>
</section>

<section class="stock-toolbar">
    <button id="stockCheckButton" class="btn btn-primary" type="button">Check now</button>
    <p id="stockSummary">Loading...</p>
</section>

<section id="stockItems" class="stock-items"></section>

<section class="stock-panel">
    <h2>Recent activity</h2>
    <div id="stockEvents" class="stock-events"></div>
</section>

@section Scripts {
    <script src="~/js/stock-watch.js" asp-append-version="true"></script>
}
